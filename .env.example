# ============================================================
# JahitFlow — contoh konfigurasi environment
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit file `.env` yang berisi kredensial sungguhan.
# ============================================================

# Aplikasi
APP_NAME="JahitFlow"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Session & Keamanan
# SESSION_SECURE=false untuk pengembangan lokal (http).
# Set true di produksi (https) — cookie hanya dikirim lewat TLS.
APP_KEY=
SESSION_SECURE=false

# Database MySQL (InnoDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jahitflow
DB_USERNAME=root
DB_PASSWORD=
